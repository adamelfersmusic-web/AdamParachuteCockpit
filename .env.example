# Tonight: fill these in and the app flips from the in-memory mock to the live vault.
# The VaultClient factory (src/lib/vault/index.ts) reads these. If unset, it uses MockVaultClient.

# Base origin of the Parachute hub, e.g. https://parachute.computer
VITE_PARACHUTE_ORIGIN=

# Vault slug. For you this is "adam".
VITE_PARACHUTE_VAULT=adam

# NOTE: a write-scoped token must NOT live in the browser bundle.
# At runtime the app talks to a thin BFF that holds the token server-side.
# This var points the app at that BFF (e.g. http://localhost:8787).
# Leave blank to stay on the mock.
VITE_COCKPIT_API=

# Dry-run gear. Set to "true" to connect to the LIVE vault but block ALL writes —
# verify that real data loads correctly before turning writes on. This replaces
# the need for a separate read-only token. Leave blank/false for normal operation.
VITE_COCKPIT_READONLY=
